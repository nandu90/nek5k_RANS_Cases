c-----------------------------------------------------------------------
c  nek5000 user-file template
c
c  user specified routines:
c     - uservp  : variable properties
c     - userf   : local acceleration term for fluid
c     - userq   : local source term for scalars
c     - userbc  : boundary conditions
c     - useric  : initial conditions
c     - userchk : general purpose routine for checking errors etc.
c     - userqtl : thermal divergence for lowMach number flows 
c     - usrdat  : modify element vertices 
c     - usrdat2 : modify mesh coordinates
c     - usrdat3 : general purpose routine for initialization
c     
c-----------------------------------------------------------------------
      include "experimental/rans_komg.f"
      include "experimental/rans_wallfunctions.f"
      include "experimental/limits.f"
      include "experimental/utilities.f"
      include "experimental/lineplot.f"      
c-----------------------------------------------------------------------
      subroutine uservp(ix,iy,iz,eg) ! set variable properties
c      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      include 'RANS_KOMG'

      integer ix,iy,iz,eg,e
      real rans_mut,rans_mutsk,rans_mutso,rans_turbPrandtl
      e = gllel(eg)

      Pr_t=coeffs(1)
      mu_t=rans_mut(ix,iy,iz,e)

      utrans = cpfld(ifield,2)
      if(ifield.eq.1) then
        udiff = cpfld(ifield,1)+mu_t
      elseif(ifield.eq.2) then !temperature
        udiff = cpfld(ifield,1)+mu_t*cpfld(ifield,2)/(Pr_t*cpfld(1,2))
      elseif(ifield.eq.3) then !tke
        udiff = cpfld(1,1)+rans_mutsk(ix,iy,iz,e)
      elseif(ifield.eq.4) then !tau
        udiff = cpfld(1,1)+rans_mutso(ix,iy,iz,e)
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg) ! set acceleration term
c
c     Note: this is an acceleration term, NOT a force!
c     Thus, ffx will subsequently be multiplied by rho(x,t).
c
c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e
c     e = gllel(eg)

      ffx = 0.0
      ffy = 0.0
      ffz = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,eg) ! set source term

c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e
      e = gllel(eg)

      qvol   = 0.0
      avol   = 0.0
      if(ifield.eq.3) then
        qvol = rans_kSrc(ix,iy,iz,e)
        avol = rans_kDiag(ix,iy,iz,e)
      elseif(ifield.eq.4) then
        qvol = rans_omgSrc(ix,iy,iz,e)
        avol = rans_omgDiag(ix,iy,iz,e)
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,eg) ! set up boundary conditions
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
c
      real wd
      common /walldist/ wd(lx1,ly1,lz1,lelv),upmin

      character*3 cbv3, cbt3, cbk3, cbo3

      common /gradywd/ ywdx(lx1,ly1,lz1,lelv),ywdy(lx1,ly1,lz1,lelv)
     $                ,ywdz(lx1,ly1,lz1,lelv),ywdc(lx1,ly1,lz1,lelv)
      real ywdx, ywdy, ywdz, ywdc

      real ydx, ydy, ydz, ydn

      integer ix,iy,iz,iside,e,eg
      real velx,vely,blunt_vel,tol
      real usn(3),tsn(3),bsn(3),ut1,ut2,uw,utau,kw, u_k,tauw
      real tw1,tw2,tkewall,omgwall,tauwall,sgnut1,sgnut2,utau1
      real yplus,uplus,Econ,kappa,veddy,visc,factr,factro,sCmu
      real tke_tmp,tau_tmp,upmin,sgnydn

      real flux_kwall, flux_tauwall,twnew,uc

      real myuin,kin,tauin
      common /inarrs/ 
     $     myuin(lx1,ly1,lz1,lelt),
     $     kin(lx1,ly1,lz1,lelt),
     $     tauin(lx1,ly1,lz1,lelt)

      e = gllel(eg)

      velx =-1.72845874696*(1-(y-2.0525)*(y-2.0525)/0.01380625)
      vely = 0.0
      temp = 0.0

      call turb_in(wd(ix,iy,iz,e),tke_tmp,tau_tmp)
c      if(ifield.eq.3) temp = tke_tmp
c      if(ifield.eq.4) temp = tau_tmp
      pa = 0

      yplus=  30.0
      Econ = 9.0
      kappa= 0.4
      sCmu = 0.3
      visc=cpfld(1,1)

      cbv3 = cbc(iside,e,1)
      cbt3 = cbc(iside,e,2)
      cbk3 = cbc(iside,e,3)
      cbo3 = cbc(iside,e,4)

      call getSnormal  (usn,ix,iy,iz,iside,e)
      ydx = ywdx(ix,iy,iz,e)
      ydy = ywdy(ix,iy,iz,e)
      ydz = ywdz(ix,iy,iz,e)
      if(if3d) then
         ydn= usn(1)*ydx+ usn(2)*ydy+ usn(3)*ydz
      else
         ydn= usn(1)*ydx+ usn(2)*ydy
      endif

      if(cbv3.eq.'shl') then
         call getangent   (tsn,ix,iy,iz,iside,e)
         call getbitangent(bsn,ix,iy,iz,iside,e)

         ut1=tsn(1)*ux+tsn(2)*uy
         ut2=0.0
         if(if3d) then
            ut1=ut1+tsn(3)*uz
            ut2=bsn(1)*ux+bsn(2)*uy+bsn(3)*uz
         endif
         uw=sqrt(ut1*ut1+ut2*ut2)
         kw=abs(ps(1))
         tauw=abs(ps(2))
         uplus=log(Econ*yplus)/kappa
         utau1=uw/uplus
         u_k = sqrt(sCmu*kw)
         utau=max(utau1,u_k)
         veddy=kappa*visc*yplus
         factr=1.0+visc/veddy
         factro= 0.5 + visc/veddy ! 1. + visc/(0.5*veddy) sigma_w=2
         
         if(uw.lt.upmin) upmin=uw
         
c     tw1=(utau*ut1)/uplus*factr
c     tw2=(utau*ut2)/uplus*factr
         sgnut1 = sign(1.,ut1)
         sgnut2 = sign(1.,ut2)
         tw1=(utau*utau1*sgnut1)*factr ! this is the G-M approach
         tw2=0.                 !(utau*utau1*sgnut2)*factr
         
         tkewall=utau*utau/sCmu
                  
c     tkewall=u_k*u_k/sCmu
         omgwall=tkewall/veddy
c     omgwall=kw/veddy
c     omgwall=u_k*u_k/sCmu/veddy
         
         tol = 1.e-6
         if(tkewall.gt.tol) then
           tauwall=1./omgwall  !veddy/tkewall
            tauwall= min(0.1,tauwall)
         else
            tauwall= 0.
         endif
         
         sgnydn = sign(1.,ydn)
         flux_kwall= 0.0
c         flux_tauwall=0.5*(sCmu*kappa*veddy/u_k)*sgnydn*factro ! this should be veddy*dtau/dy
         flux_tauwall=kappa*utau*tauw*sgnydn*factro ! this should be veddy*dtau/dy
c         write(*,*) 'WTF is flux_tauwall ', u_k,tauw,sgnydn,factro

c       set traction BC for velocity
        un  = 0.0
        tr1 =-twnew
        tr2 =-tw2
        
c       set Dirichlet BCs for tke and tau
        if(ifield.eq.3) then
          temp = tkewall
          flux = 0.0
        endif
        if(ifield.eq.4) temp = tauwall

        call unifiedWallFunc(ix,iy,iz,iside,e,tw1,tkewall,flux_tauwall)
        flux_tauwall = flux_tauwall*sgnydn
      endif

      if     (ifield.eq.1) then
        if    (cbv3.eq.'v  ') then
           ux   = myuin(ix,iy,iz,e) !blunt_vel(velx,wd)
           uy   = 0.0 !blunt_vel(vely,wd)
           uz = 0.
        elseif(cbv3.eq.'shl') then
           trn = 0
           tr1 =-tw1
           tr2 =-tw2
        endif
      elseif (ifield.eq.2) then
         temp=0.0
      elseif (ifield.eq.3) then
        if    (cbk3.eq.'t  ' .and. cbv3.eq.'shl') then
           temp= tkewall
c           write(*,*) ' WTF is tkewall ', temp
        elseif(cbk3.eq.'t  ' .and. cbv3.eq.'W  ') then
           temp= 0.
        elseif(cbk3.eq.'t  ' .and. cbv3.eq.'v  ') then
           temp= kin(ix,iy,iz,e)
        elseif(cbk3.eq.'f  ') then
           flux= 0.0
        endif
      elseif (ifield.eq.4) then
        if    (cbo3.eq.'t  ' .and. cbv3.eq.'shl') then
           temp = tauwall
        elseif(cbo3.eq.'t  ' .and. cbv3.eq.'W  ') then
           temp= 0.
        elseif(cbo3.eq.'t  ' .and. cbv3.eq.'v  ') then
           temp= tauin(ix,iy,iz,e)
        elseif(cbo3.eq.'f  ') then
           flux = flux_tauwall
c           write(*,*) ' WTF is fluxtau ', x, y, flux
        endif
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,e,eg

      e = gllel(eg)

      ux   = 0.0
      uy   = 0.0
      uz   = 0.0
      temp = 0.0

      if(ifield.eq.3) temp = 1e-4
      if(ifield.eq.4) temp = 1e-4

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk()
C      implicit none
      include 'SIZE'
      include 'TOTAL'

      common /myoutflow/ d(lx1,ly1,lz1,lelt),m1(lx1*ly1*lz1,lelt)
      real m1

      real wd
      common /walldist/ wd(lx1,ly1,lz1,lelv)
      real norm(3),pt(3),eps,planar_ave_m1,umean
      real pta(3),ptb(3)

      common /pgrads/ dpdx(lx1,ly1,lz1,lelt),dpdy(lx1,ly1,lz1,lelt),
     $     dpdz(lx1,ly1,lz1,lelt)
      real dpdx,dpdy,dpdz

      real myuin,kin,tauin
      common /inarrs/ 
     $     myuin(lx1,ly1,lz1,lelt),
     $     kin(lx1,ly1,lz1,lelt),
     $     tauin(lx1,ly1,lz1,lelt)

      nxyz = lx1*ly1*lz1
      ntot = nxyz*nelt

      if(istep.eq.0)then
         call gfldr('msfr.bare')
         call copy(myuin,vx,ntot)         
         call copy(kin,t(1,1,1,1,2),ntot)
         call copy(tauin,t(1,1,1,1,3),ntot)
      endif
      
      call gradm1(dpdx,dpdy,dpdz,pr)
      call opcolv(dpdx,dpdy,dpdz,bm1)
      call opdssum(dpdx,dpdy,dpdz)
      call opcolv(dpdx,dpdy,dpdz,binvm1)
      
      norm(1) = 1.0
      norm(2) = 0.0
      norm(3) = 0.0
      pt(1) = 0.0
      pt(2) = 0.0
      pt(3) = 0.0
      eps = 0.02

      ifxyo = .false.
      if (istep.lt.1) then
        ifxyo = .true.
        call outpost2(vx,vy,vz,pr,t,ldimt,'   ')
      endif

      if(mod(istep, 10).eq.0) then
        call print_limits
        call y_p_limits(wd,.true.)
        umean=planar_ave_m1(vx,norm,pt,eps)
        if(nio.eq.0) then
          write(6,'(a15,es13.4)') "umean:",umean
          write(6,*)
        endif
      endif

      if(istep.eq.nsteps)then
         call domain_size(xmin,xmax,ymin,ymax,zmin,zmax)
         pta(1) = -0.5
         pta(2) = 1.935
         pta(3) = 0.
         ptb(1) = -0.5
         ptb(2) = 2.17
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = -0.94
         pta(2) = 0.5
         pta(3) = 0.
         ptb(1) = 0.94
         ptb(2) = 0.5
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = 0.5
         pta(2) = 1.935
         pta(3) = 0.
         ptb(1) = 0.5
         ptb(2) = 2.17
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = -0.3399
         pta(2) = 1.935
         pta(3) = 0.
         ptb(1) = -0.3399
         ptb(2) = 2.17
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)
      endif
Cc turbulent outflow bc
c      rq  = 4.
c      uin = 0.
c      call turb_outflow(d,m1,rq,uin)

      
      
      return
      end
c-----------------------------------------------------------------------
      subroutine userqtl ! Set thermal divergence

      call userqtl_scig 

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat()   ! This routine to modify element vertices

c      implicit none

      include 'SIZE'
      include 'TOTAL'

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates
      implicit none
      include 'SIZE'
      include 'TOTAL'

      real wd(lx1,ly1,lz1,lelv)
      common /walldist/ wd

      integer iel, ifc, id_face

      do iel=1,nelt
      do ifc=1,2*ndim
         id_face = bc(5,ifc,iel,1)
         cbc(ifc,iel,1) = 'E  '
         cbc(ifc,iel,2) = 'E  '
         cbc(ifc,iel,3) = 'E  '
         cbc(ifc,iel,4) = 'E  '
         if (id_face.eq.1) then         ! inlet 
             cbc(ifc,iel,1) = 'v  '
             cbc(ifc,iel,2) = 't  '
             cbc(ifc,iel,3) = 't  '
             cbc(ifc,iel,4) = 't  '
         elseif (id_face.eq.2) then     ! outlet 
             cbc(ifc,iel,1) = 'O  '
             cbc(ifc,iel,2) = 'O  '
             cbc(ifc,iel,3) = 'O  '
             cbc(ifc,iel,4) = 'O  '
         elseif (id_face.eq.3) then     ! wall 
             cbc(ifc,iel,1) = 'shl'
             cbc(ifc,iel,2) = 't  '
             cbc(ifc,iel,3) = 'f  '
             cbc(ifc,iel,4) = 'f  '
         elseif (id_face.eq.4) then     ! centerline (axisymmetric) 
             cbc(ifc,iel,1) = 'A  '
             cbc(ifc,iel,2) = 'A  '
             cbc(ifc,iel,3) = 'A  '
             cbc(ifc,iel,4) = 'A  '
         endif
      enddo
      enddo

      if (ifstrs) call fixmska1 (v1mask,v2mask,v3mask)
      call fixcorners('shl','W  ')
      call fixcorners('shl','A  ')

      do iel=1,nelt
      do ifc=1,2*ndim
         if (cbc(ifc,iel,1) .eq. 'W  ' .or. cbc(ifc,iel,1) .eq. 'v  ')
     $                                  cbc(ifc,iel,3) = 't  '
         if (cbc(ifc,iel,1) .eq. 'W  ' .or. cbc(ifc,iel,1) .eq. 'v  ')
     $                                  cbc(ifc,iel,4) = 't  '
c         if (cbc(ifc,iel,4) .eq. 't  ') cbc(ifc,iel,4) = 'f  '
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3()

c      implicit none

      include 'SIZE'
      include 'TOTAL'

      real wd(lx1,ly1,lz1,lelv)
      common /walldist/ wd

      real w1,w2,w3,w4,w5
      real el(lx1,ly1,lz1,lelv)
      common /SCRNS/
     & w1(lx1*ly1*lz1*lelv)
     &,w2(lx1*ly1*lz1*lelv)
     &,w3(lx1*ly1*lz1*lelv)
     &,w4(lx1*ly1*lz1*lelv)
     &,w5(lx1*ly1*lz1*lelv)

      integer e
      integer ifld_k,ifld_t,id_m,id_w
      real coefs(30)
      logical ifrans_diag
      real ywdx, ywdy, ywdz, ywdc

      common /gradywd/ ywdx(lx1,ly1,lz1,lelv),ywdy(lx1,ly1,lz1,lelv)
     $                ,ywdz(lx1,ly1,lz1,lelv),ywdc(lx1,ly1,lz1,lelv)

      logical ifcoefs

C     initialize the RANS model
      ifld_k = 3 !address of tke
      ifld_t = 4 !address of tau
      ifcoefs = .false.
      ifrans_diag = .true.

C     Supported models:
c     id_m = 0 !regularized high-Re k-omega (no wall functions)
c     id_m = 1 !regularized low-Re k-omega
c     id_m = 2 !regularized high-Re k-omega SST (no wall functions)
c     id_m = 3 !regularized low-Re k-omega SST
      id_m = 4 !standard k-tau

C     Wall distance function:
      id_w = 0 ! user specified
c     id_w = 1 ! cheap_dist (path to wall, may work better for periodic boundaries)
c      id_w = 2 ! distf (coordinate difference, provides smoother function)

      call distf2(wd,1,'shl','W  ',w1,w2,w3,w4,w5)
      call rans_init(ifld_k,ifld_t,ifcoefs,coefs,id_w,wd,id_m
     $                  ,ifrans_diag,'shl')

      do e=1,nelv
        call cfill(el(1,1,1,e),real(lglel(e)),nx1*ny1*nz1)
      enddo
c      call outpost(el,wd,vz,t,pr,'ywd')

      call get_gradywd
      call get_mol_visc
      ifxyo = .true.
      call outpost2(ywdx,ywdy,vz,wd,el,1,'ywd')
      write(*,*) 'WTF 1a getting out of outpost'

c      call count_boundaries
      write(*,*) 'WTF 2 getting out of count bdries'

      call gen_rea(2)

      if (nio.eq.0) write(*,*)'end of userdat3'

      return
      end
C-----------------------------------------------------------------------
      subroutine turb_in(wd,tke,tau)
      implicit none
      include 'SIZE'
      include 'TOTAL'

      integer ix,iy,iz,e
      real wd,tke,tau

      real Re,darcy,utau,sigk,kmax,yplus,yk

      Re = 1.0/param(2)
      darcy = 0.316/(Re**0.25)
      utau = sqrt(darcy/8.0)
      sigk = 0.6
      kmax = 2.5*utau*utau
      yplus = max(wd*utau*Re,1.0e-6)
      yk=30.0

      tke=kmax*exp(-(log10(yplus/yk))**2.0/(2.0*sigk**2))
      tau=0.012*wd**2.0/cpfld(ifield,1)

      return
      end
c-----------------------------------------------------------------------
      subroutine get_mol_visc
      include 'SIZE'
      include 'TOTAL'

      common /viscmol/mul   (lx1,ly1,lz1,lelv), mul_dx(lx1,ly1,lz1,lelv)
     $               ,mul_dy(lx1,ly1,lz1,lelv), mul_dz(lx1,ly1,lz1,lelv)
      real mul, mul_dx, mul_dy, mul_dz

      integer ix,iy,iz,e,eg

      Re    = 1. /param(2)
      pi1   = 4.0*atan(1.0)

      write(*,*) 'mu Re ', param(2), Re

      do e =1,nelv
      do iz=1,nz1
      do iy=1,ny1
      do ix=1,nx1
        xx=xm1(ix,iy,iz,e)
        mul(ix,iy,iz,e)=1./Re
      enddo
      enddo
      enddo
      enddo

      call opgrad  (mul_dx,mul_dy,mul_dz,mul)
      call opdssum (mul_dx,mul_dy,mul_dz)
      call opcolv  (mul_dx,mul_dy,mul_dz,binvm1)

      write(*,*) 'WTF 1 getting out of get_mol'
      return
      end

C-----------------------------------------------------------------------
      subroutine fixcorners(cbtype1,cbtype2)

c     fixes masks for SYM face corners

      include 'SIZE'
      include 'INPUT'
      include 'GEOM'
      include 'PARALLEL'

      common /scruz/ rmlt(lx1,ly1,lz1,lelv),runx(lx1,ly1,lz1,lelv)
     $              ,runy(lx1,ly1,lz1,lelv),runz(lx1,ly1,lz1,lelv)
     $              ,rt1x(lx1,ly1,lz1,lelv),rt1y(lx1,ly1,lz1,lelv)
     $              ,rt1z(lx1,ly1,lz1,lelv),rt2x(lx1,ly1,lz1,lelv)
     $              ,rt2y(lx1,ly1,lz1,lelv),rt2z(lx1,ly1,lz1,lelv)

      character*3 cb,cbtype1,cbtype2

      nxyz1= lx1*ly1*lz1
      ntot1= nxyz1*nelv
      nfaces = 2*ldim
      tol  = 1.e-07

      call rzero  (rmlt,    ntot1)
      call oprzero(runx,runy,runz)
      call oprzero(rt1x,rt1y,rt1z)
      call oprzero(rt2x,rt2y,rt2z)

      write(*,*) 'element faces from fixmask2'
      do 1000 iel=1,nelv
      ieg = lglel(iel)
      do 100 iface=1,nfaces
         cb = cbc(iface,iel,1)
         if (cb.eq.cbtype1 .or. cb.eq.cbtype2) then
            call facind(kx1,kx2,ky1,ky2,kz1,kz2,lx1,ly1,lz1,iface)
            ia = 0
            do 10 iz=kz1,kz2
            do 10 iy=ky1,ky2
            do 10 ix=kx1,kx2
              ia =ia + 1
              rmlt(ix,iy,iz,iel)=rmlt(ix,iy,iz,iel)+1.
              runx(ix,iy,iz,iel)=runx(ix,iy,iz,iel)+unx(ia,1,iface,iel)
              runy(ix,iy,iz,iel)=runy(ix,iy,iz,iel)+uny(ia,1,iface,iel)
              rt1x(ix,iy,iz,iel)=rt1x(ix,iy,iz,iel)+t1x(ia,1,iface,iel)
              rt1y(ix,iy,iz,iel)=rt1y(ix,iy,iz,iel)+t1y(ia,1,iface,iel)
              rt2x(ix,iy,iz,iel)=rt2x(ix,iy,iz,iel)+t2x(ia,1,iface,iel)
              rt2y(ix,iy,iz,iel)=rt2y(ix,iy,iz,iel)+t2y(ia,1,iface,iel)
              if(if3d) then
               runz(ix,iy,iz,iel)=runz(ix,iy,iz,iel)+unz(ia,1,iface,iel)
               rt1z(ix,iy,iz,iel)=rt1z(ix,iy,iz,iel)+t1z(ia,1,iface,iel)
               rt2z(ix,iy,iz,iel)=rt2z(ix,iy,iz,iel)+t2z(ia,1,iface,iel)
              endif
 10         continue
         endif
 100  continue
 1000 continue

      call dssum  (rmlt,nx1,ny1,nz1)
      call opdssum(runx, runy, runz)
      call opdssum(rt1x, rt1y, rt1z)
      call opdssum(rt2x, rt2y, rt2z)

      do 2000 iel=1,nelv
      ieg = lglel(iel)
      do 200 iface=1,nfaces
         cb = cbc(iface,iel,1)
         if (cb.eq.cbtype1 .or. cb.eq.cbtype2) then
            call facind(kx1,kx2,ky1,ky2,kz1,kz2,lx1,ly1,lz1,iface)
            ia = 0
            do 20 iz=kz1,kz2
            do 20 iy=ky1,ky2
            do 20 ix=kx1,kx2
               ia =ia + 1
               amul = rmlt(ix,iy,iz,iel)
               runxs= runx(ix,iy,iz,iel)/amul
               runys= runy(ix,iy,iz,iel)/amul
               runzs= 0.0
               rt1xs= rt1x(ix,iy,iz,iel)/amul
               rt1ys= rt1y(ix,iy,iz,iel)/amul
               rt1zs= 0.0
               rt2xs= rt2x(ix,iy,iz,iel)/amul
               rt2ys= rt2y(ix,iy,iz,iel)/amul
               rt2zs= 0.0
               if(if3d) then
                  runzs= runz(ix,iy,iz,iel)/amul
                  rt1zs= rt1z(ix,iy,iz,iel)/amul
                  rt2zs= rt2z(ix,iy,iz,iel)/amul
               endif
               unmag = sqrt(runxs*runxs+runys*runys+runzs*runzs)
               t1mag = sqrt(rt1xs*rt1xs+rt1ys*rt1ys+rt1zs*rt1zs)
               t2mag = sqrt(rt2xs*rt2xs+rt2ys*rt2ys+rt2zs*rt2zs)

               if((1.0-abs(unmag)).ge.tol) then
                 write(*,'(4(1X,A),3I5,2(2X,G14.7))') 'converting BC '
     $            ,cb, ' to ','W  ', ieg, iface, ia, unmag, amul

                 cbc(iface,iel,1) = 'W  '
               endif

 20         continue
         endif
 200  continue
 2000 continue

      return
      end
c---------------------------------------------------------------------
      subroutine unifiedWallFunc(ix,iy,iz,iside,e,tw1,tke,flux_tau)
c
      implicit none
c     
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      
      integer ix,iy,iz,e,iside

      real tsn(3),bsn(3)
      real yplusc,Econ,sCmu,Ccon,kappa,kw,tauw
      real alp,bet,tol,tolmax
      real Ccon1, Ccon2

      real dpt1,dpt2,dpt,dpw,sgndpt1,up
      real udp,cosphi,acosf
      real ut1,ut2,uw,sgnut1
      real u_k,utau2,uc

      real u1plusc,u2plusc
      
      real up_plus,u1t1,u1t2,utau_plus,tw1,ukstar
      real veddy,factro,flux_tau,tke

      common /pgrads/ dpdx(lx1,ly1,lz1,lelt),dpdy(lx1,ly1,lz1,lelt),
     $     dpdz(lx1,ly1,lz1,lelt)
      real dpdx,dpdy,dpdz
      real visc,dens

      yplusc = 30.0
      Econ = 9.0
      kappa = 0.4
      sCmu = 0.3
      Ccon = log(Econ)/kappa
      alp = 5.0
      bet = 8.0
      tol = 1.e-6
      tolmax = 1.e5
      visc = cpfld(1,1)
      dens = cpfld(1,2)
     
      call getangent   (tsn,ix,iy,iz,iside,e)
      call getbitangent(bsn,ix,iy,iz,iside,e)

      ut1      = tsn(1)*ux+tsn(2)*uy
      ut2      = 0.0
      kw       = abs(ps(1))
      tauw     = abs(ps(2))
      u_k      = sqrt(sCmu*kw)
      
      if(if3d) then
         ut1    = ut1+tsn(3)*uz
         ut2    = bsn(1)*ux+bsn(2)*uy+bsn(3)*uz
      endif
      uw       = sqrt( ut1* ut1+ ut2* ut2)
      
      dpt1     = tsn(1)*dpdx(ix,iy,iz,e)+tsn(2)*dpdy(ix,iy,iz,e)
      dpt2     = 0.0
      if(if3d) then
         dpt1   = dpt1+tsn(3)*dpdz(ix,iy,iz,e)
         dpt2   = bsn(1)*dpdx(ix,iy,iz,e)+bsn(2)*dpdy(ix,iy,iz,e)
     $        +bsn(3)*dpdz(ix,iy,iz,e)
      endif
      dpw      = sqrt(dpt1*dpt1+dpt2*dpt2)
      udp      = ut1*dpt1+ut2*dpt2
      cosphi   = 1.
      if((uw*dpw).gt.tol) cosphi = udp/uw/dpw
      acosf = abs(cosphi) - 1.
      if(abs(acosf).lt.tol) cosphi=sign(1.,cosphi)

      if((dpw.gt.tol .and.dpw.lt.tolmax)) then 
         dpt1  = dpt1/dpw
         dpt2  = dpt2/dpw
      else
         dpt1  = 0.
         dpt2  = 0.
         dpw   = 0.
      endif
      
      up       = (visc*dpw/dens)**(1./3.)
      
      if    (cosphi.eq. 1.) then
         utau2 = abs(u_k    -alp*kappa*up)
      elseif(cosphi.eq.-1.) then
         utau2 =     u_k    +alp*kappa*up
      else
         write(*,*) 'This is only for 2D and cos(phi)=+-1'
         write(*,*) 'WTF is cosphi ', uw, dpw, udp, cosphi
      endif
      
      uc = utau2 + up
      Ccon1   = 0.
      u1plusc = 0.
      if(utau2.ne.0. .and. uc.ne.0.) then
         Ccon1   = (utau2/uc)*(log(utau2/uc)/kappa+ Ccon)
         u1plusc = (utau2/uc)* log(  yplusc)/kappa+ Ccon1
      endif
      Ccon2   = 0.
      u2plusc = 0.
      if(up   .ne.0. .and. uc.ne.0.) then
         Ccon2   = (up   /uc)*(log(up   /uc)*alp  + bet )
         u2plusc = (up   /uc)* log(  yplusc)*alp  + Ccon2
      endif
        
      u1t1    = ut1 - uc*dpt1 * u2plusc
      u1t2    = ut2 - uc*dpt2 * u2plusc

      ukstar= abs(sign(1.,ut1)*utau2  +dpt1*alp*kappa*up)
        
      veddy=kappa*visc*yplusc*ukstar/uc

      if(veddy.le.tol .or. veddy.ne.veddy) then
         factro= 0.5
      else
         factro= 0.5 + visc/veddy 
      endif

      if(uc.ne.0.) tw1= (u1t1/u1plusc)*(utau2/uc)*utau2
     $     + up**2*dpt1*(up/uc)*yplusc
      
      flux_tau=kappa*ukstar*tauw*factro ! this should be veddy*dtau/dy

      return
      end
c---------------------------------------------------------------------
      subroutine blenders(f1,f2,yt,yc)

      real f1,f2,yt,yc

      real a1,a2,a3
      real b0,b1,b2,b3,b4
      real c0,c1,c2,c3,c4

      kappa = 0.41
      c = 5.0

      alpha = 5.0
      beta = 8.0

      a1 = 1.0
      a2 = 1e-2
      a3 = -2.9e-3

      b0 = -0.872
      b1 = 1.465
      b2 = -7.02e-2
      b3 = 1.66e-3
      b4 = -1.495e-5

      c0 = 8.6
      c1 = 0.1864
      c2 = -2.006e-3
      c3 = 1.144e-5
      c4 = -2.551e-8
      
      if(yt.lt.5.0)then
         f1 = a1*yt + a2*yt**2 + a3*yt**3
      elseif(yt.ge.5. .and. yt.lt.30.)then
         f1 = b0 + b1*yt + b2*yt**2 + b3*yt**3 + b4*yt**4
      elseif(yt.ge.30.0 .and. yt.lt.140.)then
         f1 = c0 + c1*yt + c2*yt**2 + c3*yt**3 + c4*yt**4
      else
         f1 = (1./kappa)*log(yt) + c
      endif

      if(yc.lt.4.0)then
         f2 = a2*yc**2 + a3*yc**3
      elseif(yc.ge.4. .and. yc.lt.15.)then
         f2 = b0 + b1*yc + b2*yc**2 + b3*yc**3 + b4*yc**4
      elseif(yc.ge.15. .and. yc.lt.30.)then
         f2 = c0 + c1*yc + c2*yc**2 + c3*yc**3 + c4*yc**4
      else
         f2 = alpha*log(yc) + beta
      endif

      return
      end
