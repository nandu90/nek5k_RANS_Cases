c-----------------------------------------------------------------------
c  nek5000 user-file template
c
c  user specified routines:
c     - uservp  : variable properties
c     - userf   : local acceleration term for fluid
c     - userq   : local source term for scalars
c     - userbc  : boundary conditions
c     - useric  : initial conditions
c     - userchk : general purpose routine for checking errors etc.
c     - userqtl : thermal divergence for lowMach number flows 
c     - usrdat  : modify element vertices 
c     - usrdat2 : modify mesh coordinates
c     - usrdat3 : general purpose routine for initialization
c     
c-----------------------------------------------------------------------
      include "experimental/rans_komg.f"
      include "experimental/rans_wallfunctions.f"
      include "/home/dshaver/NEKSOURCE/usrcode/limits.f"
      include "/home/dshaver/NEKSOURCE/usrcode/utilities.f"
      include "/home/dshaver/NEKSOURCE/usrcode/lineplot.f"      
c-----------------------------------------------------------------------
      subroutine uservp(ix,iy,iz,eg) ! set variable properties

c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      include 'RANS_KOMG'

      integer e
      e = gllel(eg)

      Pr_t=coeffs(1)
      mu_t=rans_mut(ix,iy,iz,e)

      utrans = cpfld(ifield,2)
      if(ifield.eq.1) then
        udiff = cpfld(ifield,1)+mu_t
      elseif(ifield.eq.2) then !temperature
        udiff = cpfld(ifield,1)+mu_t*cpfld(ifield,2)/(Pr_t*cpfld(1,2))
      elseif(ifield.eq.3) then !tke
        udiff = cpfld(1,1)+rans_mutsk(ix,iy,iz,e)
      elseif(ifield.eq.4) then !tau
        udiff = cpfld(1,1)+rans_mutso(ix,iy,iz,e)
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg) ! set acceleration term
c
c     Note: this is an acceleration term, NOT a force!
c     Thus, ffx will subsequently be multiplied by rho(x,t).
c
c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e
c     e = gllel(eg)

      ffx = 0.0
      ffy = 0.0
      ffz = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,eg) ! set source term

c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e
      e = gllel(eg)

      qvol   = 0.0
      avol   = 0.0
      if(ifield.eq.3) then
        qvol = rans_kSrc(ix,iy,iz,e)
        avol = rans_kDiag(ix,iy,iz,e)
      elseif(ifield.eq.4) then
        qvol = rans_omgSrc(ix,iy,iz,e)
        avol = rans_omgDiag(ix,iy,iz,e)
c        write(*,*)qvol,avol
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,eg) ! set up boundary conditions
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
c
      real wd,upmin
      common /walldist/ wd(lx1,ly1,lz1,lelv),upmin

      integer ix,iy,iz,iside,e,eg
      real tke_in,tau_in

c
      real usn(3),tsn(3),bsn(3),ut1,ut2,uw,utau,kw
      real tw1,tw2,tkewall,omgwall,tauwall
      real yplus,uplus,Econ,kappa,veddy,visc,factr,sCmu

      character*3 cbv3, cbt3, cbk3, cbo3, cb3

      real tke_tmp,tau_tmp,uin,tol
c     
      e = gllel(eg)
                  
      cb3  = cbc(iside,e,ifield)
      cbv3 = cbc(iside,e,1)
      cbt3 = cbc(iside,e,2)
      cbk3 = cbc(iside,e,3)
      cbo3 = cbc(iside,e,4)

c--------------------------------
c     Wall function related
      if(cbk3.eq.'t  ' .and. cbv3.eq.'v  ')
     $     call turb_in(ym1(ix,iy,iz,e),tke_tmp,tau_tmp,uin)

      yplus= 30.0
      Econ = 9.0
      kappa= 0.4
      sCmu = 0.3
      visc=cpfld(1,1)

      if(cbv3.eq.'shl') then
        call getangent   (tsn,ix,iy,iz,iside,e)
        call getbitangent(bsn,ix,iy,iz,iside,e)

        ut1=tsn(1)*ux+tsn(2)*uy
        ut2=0.0
        if(if3d) then
          ut1=ut1+tsn(3)*uz
          ut2=bsn(1)*ux+bsn(2)*uy+bsn(3)*uz
        endif
        uw=sqrt(ut1*ut1+ut2*ut2)
        kw=abs(t(ix,iy,iz,e,2))
        uplus=log(Econ*yplus)/kappa
        utau=max(uw/uplus,sqrt(sCmu*kw))
        veddy=kappa*visc*yplus
        factr=1.0+visc/veddy

        if(uw.lt.upmin) upmin=uw

        tw1=(utau*ut1)/uplus*factr
        tw2=(utau*ut2)/uplus*factr

        tkewall=utau*utau/sCmu
        omgwall=kw/veddy
        tauwall=1./omgwall !veddy/tkewall

        tol = 1.e-6
        if(tkewall.gt.tol) then
           tauwall=1./omgwall   !veddy/tkewall
           tauwall= min(0.1,tauwall)
        else
           tauwall= 0.
        endif

c       set traction BC for velocity
        un  = 0.0
        tr1 =-tw1
        tr2 =-tw2

      endif

      if     (ifield.eq.1) then
        if    (cbv3.eq.'v  ') then
           ux   = uin
           uy   = 0.
           uz = 0.
        elseif(cbv3.eq.'shl') then
           trn = 0
           tr1 =-tw1
           tr2 =-tw2
        endif
      elseif (ifield.eq.2) then
        temp=0.0
        flux=1.0
      elseif (ifield.eq.3) then
        if    (cbk3.eq.'t  ' .and. cbv3.eq.'shl') then
           temp= tkewall
        elseif(cbk3.eq.'t  ' .and. cbv3.eq.'W  ') then
           temp= 0.
        elseif(cbk3.eq.'t  ' .and. cbv3.eq.'v  ') then
           temp= tke_tmp
        elseif(cbk3.eq.'f  ') then
           flux= 0.0 ! flux_kwall
        endif
      elseif (ifield.eq.4) then
        if    (cbo3.eq.'t  ' .and. cbv3.eq.'shl') then
           temp = tauwall
        elseif(cbo3.eq.'t  ' .and. cbv3.eq.'W  ') then
           temp= 0.
        elseif(cbo3.eq.'t  ' .and. cbv3.eq.'v  ') then
           temp= tau_tmp
        elseif(cbo3.eq.'f  ') then
           flux = 0. !flux_tauwall
        endif
      endif


      return
      end
c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,e,eg

      e = gllel(eg)

      ux   = 0.0
      uy   = 0.0
      uz   = 0.0
      temp = 0.0

      if(ifield.eq.3)temp=1e-5
      if(ifield.eq.4)temp=1e-1

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk()
C      implicit none
      include 'SIZE'
      include 'TOTAL'

      common /myoutflow/ d(lx1,ly1,lz1,lelt),m1(lx1*ly1*lz1,lelt)
      real m1
      
      real wd,upmin
      common /walldist/ wd(lx1,ly1,lz1,lelv),upmin
      real norm(3),pt(3),eps,planar_ave_m1,umean

      norm(1) = 1.0
      norm(2) = 0.0
      norm(3) = 0.0
      pt(1) = 0.0
      pt(2) = 0.0
      pt(3) = 0.0
      eps = 0.02

      
      if(mod(istep,100).eq.0) then
        call print_limits
        call y_p_limits(wd,.true.)
        umean=planar_ave_m1(vx,norm,pt,eps)
        if(nio.eq.0) then
          write(6,'(a15,es13.4)') "umean:",umean
          write(6,*)
        endif
      endif

      
c turbulent outflow bc
c      rq  = 4.
c      uin = 0.
c      call turb_outflow(d,m1,rq,uin)

      return
      end
c-----------------------------------------------------------------------
      subroutine userqtl ! Set thermal divergence

      call userqtl_scig 

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat()   ! This routine to modify element vertices

c      implicit none

      include 'SIZE'
      include 'TOTAL'

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates

c      implicit none

      include 'SIZE'
      include 'TOTAL'

      integer iel, ifc, id_face
      integer i, e, f, n
      real dhi
      
      ntot = nx1*ny1*nz1*nelt

      do iel=1,nelt
      do ifc=1,2*ndim
         id_face = bc(5,ifc,iel,1)
         if (id_face.eq.1) then         ! inlet 
             cbc(ifc,iel,1) = 'v  '
         elseif (id_face.eq.2) then     ! outlet 
             cbc(ifc,iel,1) = 'O  '
         elseif (id_face.eq.3) then     ! shear layer 
             cbc(ifc,iel,1) = 'shl'
         elseif (id_face.eq.4) then     ! centerline (axisymmetric) 
             cbc(ifc,iel,1) = 'A  '
         endif
      enddo
      enddo

c     k-tau BCs are reset in usrdat3->rans_init
      do i=2,ldimt1
      do e=1,nelt
      do f=1,ldim*2
        cbc(f,e,i)=cbc(f,e,1)
        if(cbc(f,e,1).eq.'shl') cbc(f,e,i)='f  '
        if(cbc(f,e,1).eq.'v  ') cbc(f,e,i)='t  '
        if(cbc(f,e,1).eq.'W  ') cbc(f,e,i)='t  '
      enddo
      enddo
      enddo
      
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3()

c      implicit none

      include 'SIZE'
      include 'TOTAL'

      real wd(lx1,ly1,lz1,lelv),upmin
      common /walldist/ wd,upmin

      logical ifcoefs

C     initialize the RANS model
      ifld_k = 3 !address of tke
      ifld_t = 4 !address of tau
      ifcoefs = .false.

C     Supported models:
c     id_m = 0 !regularized high-Re k-omega (no wall functions)
c     id_m = 1 !regularized low-Re k-omega
c     id_m = 2 !regularized high-Re k-omega SST (no wall functions)
c     id_m = 3 !regularized low-Re k-omega SST
      id_m = 4 !standard k-tau

C     Wall distance function:
c     id_w = 0 ! user specified
c     id_w = 1 ! cheap_dist (path to wall, may work better for periodic boundaries)
      id_w = 2 ! distf (coordinate difference, provides smoother function)

      call rans_init(ifld_k,ifld_t,ifcoefs,coefs,id_w,wd,id_m,'shl')

      call count_boundaries
      
      return
      end
C-----------------------------------------------------------------------
      subroutine turb_in(yin,tke,tau,ux)
      implicit none
      include 'SIZE'
      include 'TOTAL'

      integer ix,iy,iz,e
      real yin,tke,tau,xin,ux

      real Re,darcy,utau,sigk,kmax,yplus,yk,wd
      real hwidth,ymax,ytemp,ycen
      
      real kappa,cplus,uplus,yplusmax,umax,wd100

      hwidth = 0.235/2.0
      ymax = 2.17
      ycen = ymax-hwidth
      ytemp = abs(yin-ycen)

      wd = abs(hwidth-ytemp)

      Re = 1.0/param(2)
      darcy = 0.316/(Re**0.25)
      utau = sqrt(darcy/8.0)
      sigk = 0.6
      kmax = 2.5*utau*utau
      yplus = wd*utau*Re
!     The tau equation becomes singular if yplus
!     is not incremented by 100. (0 at wall causes problems)
      yplus = yplus+100.0
      yk = 30.0
      
      tau=0.012*wd**2.0/cpfld(1,1)            
      tke=kmax*exp(-(log10(yplus/yk))**2.0/(2.0*sigk**2))
 
!     Jun's profile truncated
c     Constant max value assigned at the center
      wd100 = 100.0/(utau*Re)
      ytemp = yin
      if(ytemp.ge.ycen)then
         ytemp = ytemp-wd100
         ytemp = max(ytemp,ycen)
      else
         ytemp = ytemp+wd100
         ytemp = min(ytemp,ycen)
      endif

c      ytemp = yin
c     From Ananias
      Re = 1.0/param(2)
      darcy = 0.316/(Re**0.25)
      utau = sqrt(darcy/8.0)
      sigk = 0.6
      kmax = 2.5*utau*utau
      yplus = max(wd*utau*Re,1.0e-6)
      yk=30.0

      tke=kmax*exp(-(log10(yplus/yk))**2.0/(2.0*sigk**2))
      tau=0.012*wd**2.0/cpfld(1,1)
      ux = -1.72845874696*(1-(yin-2.0525)*(yin-2.0525)/0.01380625)
      
      return
      end
c-----------------------------------------------------------------------
