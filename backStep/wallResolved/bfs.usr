#include "experimental/rans_komg.f"

c-----------------------------------------------------------------------
c  nek5000 user-file template
c
c  user specified routines:
c     - uservp  : variable properties
c     - userf   : local acceleration term for fluid
c     - userq   : local source term for scalars
c     - userbc  : boundary conditions
c     - useric  : initial conditions
c     - userchk : general purpose routine for checking errors etc.
c     - userqtl : thermal divergence for lowMach number flows 
c     - usrdat  : modify element vertices 
c     - usrdat2 : modify mesh coordinates
c     - usrdat3 : general purpose routine for initialization
c     
c-----------------------------------------------------------------------
      include "utilities.f"
      include "limits.f"
      include "/home/dshaver/NEKSOURCE/usrcode/lineplot.f"      
c-----------------------------------------------------------------------
      subroutine uservp(ix,iy,iz,eg) ! set variable properties

c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      include 'RANS_KOMG'

      integer e
      e = gllel(eg)

      Pr_t=coeffs(1)
      mu_t=rans_mut(ix,iy,iz,e)

      utrans = cpfld(ifield,2)
      if(ifield.eq.1) then
        udiff = cpfld(ifield,1)+mu_t
      elseif(ifield.eq.2) then !temperature
        udiff = cpfld(ifield,1)+mu_t*cpfld(ifield,2)/(Pr_t*cpfld(1,2))
      elseif(ifield.eq.3) then !tke
        udiff = cpfld(1,1)+rans_mutsk(ix,iy,iz,e)
      elseif(ifield.eq.4) then !tau
        udiff = cpfld(1,1)+rans_mutso(ix,iy,iz,e)
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg) ! set acceleration term
c
c     Note: this is an acceleration term, NOT a force!
c     Thus, ffx will subsequently be multiplied by rho(x,t).
c
c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e
c     e = gllel(eg)

      ffx = 0.0
      ffy = 0.0
      ffz = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,eg) ! set source term

c      implicit none

      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e
      e = gllel(eg)

      qvol   = 0.0
      avol   = 0.0
      if(ifield.eq.3) then
        qvol = rans_kSrc(ix,iy,iz,e)
        avol = rans_kDiag(ix,iy,iz,e)
      elseif(ifield.eq.4) then
        qvol = rans_omgSrc(ix,iy,iz,e)
        avol = rans_omgDiag(ix,iy,iz,e)
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,eg) ! set up boundary conditions
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
c
      real wd
      common /walldist/ wd(lx1,ly1,lz1,lelv)

      integer ix,iy,iz,iside,e,eg
      real tke_tmp,tau_tmp
      
      real myuin,kin,tauin
      common /inarrs/ 
     $     myuin(lx1,ly1,lz1,lelt),
     $     kin(lx1,ly1,lz1,lelt),
     $     tauin(lx1,ly1,lz1,lelt)

      e = gllel(eg)

      ux   = myuin(ix,iy,iz,e)
      uy   = 0.0
      uz   = 0.0
            
      if(cbc(iside,e,1).eq.'W  ')then
         temp = 0.0
      elseif(cbc(iside,e,1).eq.'v  ')then
         if(ifield.eq.3)then
            temp = kin(ix,iy,iz,e)
         elseif(ifield.eq.4)then
            temp = tauin(ix,iy,iz,e)
         endif
      endif

c      call turb_in(wd(ix,iy,iz,e),tke_tmp,tau_tmp)
c      if(ifield.eq.3) temp = tke_tmp
c      if(ifield.eq.4) temp = tau_tmp

      return
      end
c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,e,eg

      e = gllel(eg)

      ux   = 1.0
      uy   = 0.0
      uz   = 0.0
      temp = 1e-4

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk()
C      implicit none
      include 'SIZE'
      include 'TOTAL'

      common /myoutflow/ d(lx1,ly1,lz1,lelt),m1(lx1*ly1*lz1,lelt)
      real m1

      real wd
      common /walldist/ wd(lx1,ly1,lz1,lelv)
      real norm(3),pt(3),eps,planar_ave_m1,umean
      real pta(3),ptb(3)

      real myuin,kin,tauin
      common /inarrs/ 
     $     myuin(lx1,ly1,lz1,lelt),
     $     kin(lx1,ly1,lz1,lelt),
     $     tauin(lx1,ly1,lz1,lelt)

      real tvx,tvy,t2,t3
      common tvx(lx1,ly1,lz1,lelt),
     $     tvy(lx1,ly1,lz1,lelt),
     $     t2(lx1,ly1,lz1,lelt),
     $     t3(lx1,ly1,lz1,lelt)

      norm(1) = 1.0
      norm(2) = 0.0
      norm(3) = 0.0
      pt(1) = 0.0
      pt(2) = 0.0
      pt(3) = 0.0
      eps = 0.02

      nxyz = lx1*ly1*lz1
      ntot = nxyz*nelt

      if(istep.eq.0)then
         call copy(tvx,vx,ntot)
         call copy(tvy,vy,ntot)
         call copy(t2,t(1,1,1,1,2),ntot)
         call copy(t3,t(1,1,1,1,3),ntot)

         call gfldr('bfs.bare')
         call copy(myuin,vx,ntot)         
         call copy(kin,t(1,1,1,1,2),ntot)
         call copy(tauin,t(1,1,1,1,3),ntot)

         call copy(vx,tvx,ntot)
         call copy(vy,tvy,ntot)
         call copy(t(1,1,1,1,2),t2,ntot)
         call copy(t(1,1,1,1,3),t3,ntot)
      endif

      if(mod(istep,100).eq.0) then
        call print_limits
        call y_p_limits(wd,.true.)
        umean=planar_ave_m1(vx,norm,pt,eps)
        if(nio.eq.0) then
          write(6,'(a15,es13.4)') "umean:",umean
          write(6,*)
        endif
      endif

Cc turbulent outflow bc
c      rq  = 4.
c      uin = 0.
c      call turb_outflow(d,m1,rq,uin)

      if(istep.eq.nsteps)then
         call domain_size(xmin,xmax,ymin,ymax,zmin,zmax)
         pta(1) = -4.0
         pta(2) = 0.0
         pta(3) = 0.
         ptb(1) = -4.0
         ptb(2) = 2.0
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = 0.0
         pta(2) = 0.0
         pta(3) = 0.
         ptb(1) = 0.0
         ptb(2) = 2.0
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = 1.5
         pta(2) = -1.0
         pta(3) = 0.
         ptb(1) = 1.5
         ptb(2) = 2.0
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = 2.5
         pta(2) = -1.0
         pta(3) = 0.
         ptb(1) = 2.5
         ptb(2) = 2.0
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = 5.0
         pta(2) = -1.0
         pta(3) = 0.
         ptb(1) = 5.0
         ptb(2) = 2.0
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = 6.0
         pta(2) = -1.0
         pta(3) = 0.
         ptb(1) = 6.0
         ptb(2) = 2.0
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = 8.0
         pta(2) = -1.0
         pta(3) = 0.
         ptb(1) = 8.0
         ptb(2) = 2.0
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)

         pta(1) = 10.0
         pta(2) = -1.0
         pta(3) = 0.
         ptb(1) = 10.0
         ptb(2) = 2.0
         ptb(3) = 0.
         call lineplot(pta,ptb,1001)
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userqtl ! Set thermal divergence

      call userqtl_scig 

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat()   ! This routine to modify element vertices

c      implicit none

      include 'SIZE'
      include 'TOTAL'

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates

c      implicit none

      include 'SIZE'
      include 'TOTAL'

      integer iel, ifc, id_face
      integer i, e, f, n
      real dhi

      ntot = nx1*ny1*nz1*nelt

      do iel=1,nelt
      do ifc=1,2*ndim
         id_face = bc(5,ifc,iel,1)
         if (id_face.eq.31) then         ! inlet 
             cbc(ifc,iel,1) = 'v  '
         elseif (id_face.eq.32) then     ! outlet 
             cbc(ifc,iel,1) = 'O  '
         elseif (id_face.eq.30) then     ! wall 
             cbc(ifc,iel,1) = 'W  '
          endif
      enddo
      enddo

      do i=2,ldimt1
      do e=1,nelt
      do f=1,ldim*2
        cbc(f,e,i)=cbc(f,e,1)
        if(cbc(f,e,1).eq.'W  ') cbc(f,e,i)='t  '
        if(cbc(f,e,1).eq.'v  ') cbc(f,e,i)='t  '
      enddo
      enddo
      enddo
      
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3()

c      implicit none

      include 'SIZE'
      include 'TOTAL'

      real wd(lx1,ly1,lz1,lelv)
      common /walldist/ wd

      logical ifcoefs

C     initialize the RANS model
      ifld_k = 3 !address of tke
      ifld_t = 4 !address of tau
      ifcoefs = .false.

C     Supported models:
c     id_m = 0 !regularized high-Re k-omega (no wall functions)
c     id_m = 1 !regularized low-Re k-omega
c     id_m = 2 !regularized high-Re k-omega SST (no wall functions)
c     id_m = 3 !regularized low-Re k-omega SST
      id_m = 4 !standard k-tau

C     Wall distance function:
c     id_w = 0 ! user specified
c     id_w = 1 ! cheap_dist (path to wall, may work better for periodic boundaries)
      id_w = 2 ! distf (coordinate difference, provides smoother function)

      call rans_init(ifld_k,ifld_t,ifcoefs,coefs,id_w,wd,id_m)

c      ifflow = .false.
c      ifheat = .false.
      return
      end
C-----------------------------------------------------------------------
