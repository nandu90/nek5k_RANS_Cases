FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1.0;

boundaryField
{
  lowerWall
    {
        type            omegaWallFunction;//fixedValue;
	value           uniform 0.0;
    }
  upperWall
    {
        type            omegaWallFunction;//fixedValue;
	value           uniform 0.0;
    }
    inlet
    {
      type            timeVaryingMappedFixedValue;
    }
    outlet
    {
        type            zeroGradient;
    }
    frontAndBack
      {
	type empty;
      }
}


