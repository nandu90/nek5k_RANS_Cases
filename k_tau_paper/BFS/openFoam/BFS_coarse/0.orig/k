FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.001;

boundaryField
{
  lowerWall
    {
      type                fixedValue;
      value               uniform 0.;
    }
  upperWall
    {
      type                fixedValue;
      value               uniform 0.;
    }
    inlet
    {
        type            timeVaryingMappedFixedValue;
    }
    outlet
    {
        type            zeroGradient;
    }
    frontAndBack
      {
	type empty;
      }
}


