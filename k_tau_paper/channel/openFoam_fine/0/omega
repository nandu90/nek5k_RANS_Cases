FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1.5;

boundaryField
{
  walls
    {
        type            omegaWallFunction;
	value           uniform 0.0;
    }

    syms
    {
        type            symmetryPlane;
    }

    frontAndBack
    {
        type            empty;
    }
    left
    {
        type            cyclic;
    }
    right
    {
        type            cyclic;
    }
}


